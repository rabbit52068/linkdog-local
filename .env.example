# hermes-linkdog adapter 環境變數（複製為 .env 後填入實際值）
# 主機 LAN IP（韌體 URL 用）
# Leave empty to auto-detect the LAN IP; set explicitly to override.
LINKDOG_HOST=
# adapter 監聽 port
LINKDOG_PORT=8003

# Bearer token for the dashboard and control APIs from other LAN hosts.
# Localhost callers (e.g. the Hermes MCP bridge) never need it. Leave empty to
# refuse all LAN access to those APIs. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
LINKDOG_API_TOKEN=

# Phase 4 語音鏈路安全 gate。完成實機播放驗證前保持 false。
LINKDOG_VOICE_INPUT_ENABLED=false
# faster-whisper ASR
LINKDOG_ASR_MODEL=base
LINKDOG_ASR_DEVICE=cpu
LINKDOG_ASR_COMPUTE_TYPE=int8
# "auto" (or empty) enables language detection, which is required to
# transcribe Chinese and mixed Chinese/English speech. faster-whisper has no
# literal "auto" code -- the adapter maps it to None internally. Pin a code
# such as "en" to skip detection (slightly faster, Chinese is then
# mistranslated instead of merely misheard).
LINKDOG_ASR_LANGUAGE=auto
LINKDOG_ASR_TIMEOUT=15
LINKDOG_ASR_INITIAL_PROMPT=

# Voice-path chat LLM (OpenAI-compatible; e.g. https://ollama.com/v1). Legacy LINKDOG_HERMES_* names still work.
LINKDOG_CHAT_API_URL=http://127.0.0.1:8642/v1
LINKDOG_CHAT_API_KEY=
# Leave empty when talking to an OpenAI-compatible endpoint that does not need
# a provider hint (e.g. direct https://ollama.com/v1). Set to "ollama-cloud"
# only when routing through the Hermes API server, which reads this field.
LINKDOG_CHAT_PROVIDER=
# Fallback only: used when data/settings.json does not exist yet. Once
# settings.json exists, the live conversation model always comes from its
# "model" field (app/main.py::build_chat_client). Keep this value inside the
# live Ollama catalog, or the dashboard will show a model it then refuses to
# persist (PUT /api/settings validates against the catalog).
LINKDOG_CHAT_MODEL=deepseek-v4.1-flash
LINKDOG_CHAT_HISTORY_TURNS=6
LINKDOG_CHAT_TIMEOUT=60

# TTS 與 16 kHz mono Opus downlink
LINKDOG_TTS_VOICE=en-US-AriaNeural
LINKDOG_TTS_FALLBACK_VOICE=Samantha
LINKDOG_EDGE_TTS_COMMAND=edge-tts
LINKDOG_FFMPEG_COMMAND=ffmpeg
LINKDOG_SAY_COMMAND=say

# Pocket TTS（character voice，只支援英文）
LINKDOG_TTS_BACKEND=
LINKDOG_POCKET_VOICE=cosette

# Listening 狀態無有效語音多久後說休息語句並回 idle；0 代表停用
LINKDOG_IDLE_TIMEOUT_SECONDS=60

# 播放被喚醒詞中斷後，下一輪 ASR/TTS 前的穩定等待時間
LINKDOG_ABORT_COOLDOWN=2.0
